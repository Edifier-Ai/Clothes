{
  "name": "clothes",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "android": "pnpm --filter @clothes/mobile run android",
    "start": "pnpm --filter @clothes/mobile run start",
    "bench:fixtures": "tsx scripts/segmentation-benchmark/generateFixtures.ts",
    "bench:run": "tsx scripts/segmentation-benchmark/runBenchmark.ts",
    "bench:validate": "tsx scripts/segmentation-benchmark/validateReport.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4"
  }
}
